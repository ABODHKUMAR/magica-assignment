# ----------------------------------------------------------------------------
# Py — Workflow Builder environment template
# Copy to `.env` and fill in once credentials are available.
# The app runs in a DEGRADED/LOCAL mode when optional keys are missing
# (see task.md Section G / Open Questions).
# ----------------------------------------------------------------------------

# Database — PostgreSQL (Neon). Required for persistence.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Clerk — Authentication. Required for auth + protected routes.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Google Gemini — LLM execution (free tier via Google AI Studio).
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-3.1-pro-preview"

# Trigger.dev — Task execution. When unset, execution falls back to local inline run.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# Transloadit — Image upload/hosting + crop assist.
NEXT_PUBLIC_TRANSLOADIT_KEY=""
TRANSLOADIT_SECRET=""
TRANSLOADIT_TEMPLATE_ID=""

# Candidate attribution (hard requirement — logged on every page)
NEXT_PUBLIC_CANDIDATE_LINKEDIN="https://www.linkedin.com/in/abodh-shah/"
